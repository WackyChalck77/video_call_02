{
	auto_https disable_redirects
	servers {
		protocols h1
	}
}

# MY_IP/CERT_DIR берутся из окружения (см. start.sh).
#
# Подстановка {$VAR:default} выполняется при РАЗБОРЕ Caddyfile — это важно:
# адрес сайта обязан быть литералом на этапе парсинга, рантайм-плейсхолдер
# {env.VAR} в адресе не раскроется.
#
# Значение по умолчанию нужно писать у КАЖДОГО вхождения: `{$MY_IP:127.0.0.1}`
# и `{$MY_IP}` — это два разных плейсхолдера, второй без переменной раскроется
# в пустую строку (и caddy упадёт на открытии файла ".pem").
{$MY_IP:127.0.0.1}:8443 {
	tls {$CERT_DIR:certs}/{$MY_IP:127.0.0.1}.pem {$CERT_DIR:certs}/{$MY_IP:127.0.0.1}-key.pem
	reverse_proxy /ws localhost:7000
	file_server
}
