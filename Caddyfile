{
	# Свой админ-порт. Дефолтный 2019 занят системным сервисом caddy.service,
	# и любой «caddy reload/stop» без --address ушёл бы именно в него.
	admin 127.0.0.1:2020
	auto_https disable_redirects
	servers {
		protocols h1
	}
}

# Адрес — только порт, без IP: слушаем все интерфейсы. IP попадает в конфиг
# только как SAN сертификата (certs/tls.pem), который выпускает ./start.sh,
# и как nat1to1 в sfu.toml. Поэтому при смене сети Caddyfile не меняется.
:8443 {
	tls {$TLS_CRT:certs/tls.pem} {$TLS_KEY:certs/tls-key.pem}
	reverse_proxy /ws localhost:7000
	file_server
}
